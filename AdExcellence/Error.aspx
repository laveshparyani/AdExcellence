<%@ Page Language="C#" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong - AdExcellence</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; background: #f4f5f7; color: #1f2933; margin: 0; }
        .wrap { max-width: 560px; margin: 12vh auto; background: #fff; padding: 40px; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,.08); text-align: center; }
        h1 { color: #d32f2f; margin: 0 0 12px; font-size: 28px; }
        p { line-height: 1.6; color: #52606d; }
        a.btn { display: inline-block; margin-top: 20px; padding: 12px 24px; background: #d32f2f; color: #fff; text-decoration: none; border-radius: 8px; }
    </style>
</head>
<body>
    <div class="wrap">
        <h1>Something went wrong</h1>
        <p>Sorry, an unexpected error occurred while processing your request.
           Please try again in a moment, or return to the home page.</p>
        <a class="btn" href="home.aspx">Return to Home</a>
    </div>
</body>
</html>
